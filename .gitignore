# --- Dependencias y artefactos locales de OpenCode ---
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# --- Herramientas de desarrollo (no forman parte del sistema) ---
.archify/
.playwright-mcp/

# --- Datos privados del negocio (repo público: NO se suben) ---
# Cada producto y cada dueño tiene su carpeta con precios del dueño, comisiones y vales.
# El sistema (agentes, reglas, plantillas) sí se versiona; el trabajo real, no.
agencia/productos/*/
agencia/proveedores/*/

# --- Empresa: trabajo interno por proyecto (el sistema sí se versiona) ---
# brief, investigación, requerimientos, reportes… quedan en local.
empresa/proyectos/*/

# --- Secretos de los proyectos de software (solo .env.example se versiona) ---
proyectos/*/*/.env
**/.env.local

# --- Sistema / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/